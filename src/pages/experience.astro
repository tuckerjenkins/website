---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import portrait from '../assets/james-about.jpg';

const cases = [
	{
		featured: true,
		eyebrow: 'At AKQA',
		stat: '$60M',
		statLabel: 'annual partnership value, at its peak',
		org: 'Nike',
		project: 'Multi-region partnership',
		body: "I was the original team member who built the Nike partnership at AKQA, growing it into an eight-year relationship across Nike UK, EMEA, LATAM, APAC and the US — including the Beijing Olympics, the Nike+ launch, and multiple World Cup campaigns, activating and executing across markets alongside Wieden+Kennedy's global brand strategy.",
	},
	{
		eyebrow: 'As CEO, 2023–2025',
		stat: 'SEK 289.6m',
		statLabel: 'Sweden parent-company revenue, FY2025',
		org: 'Forsman & Bodenfors',
		project: 'Group CEO, then European CEO',
		body: 'As Group CEO, then European CEO, across Sweden, the UK and Ireland, I led the harder structural changes needed to reset the business for its next chapter. Back out the one-off restructuring costs and the underlying, Nordic-weighted business was close to breakeven-to-modestly-profitable in FY2025 — not the double-digit-million loss the headline number shows. The closest available proxy, the Sweden parent company alone (excluding Singapore, but also excluding the Inhouse and Happy subsidiaries), posted SEK 289.6m revenue, SEK 134.6m gross profit, and a –0.8m adjusted operating result.',
	},
	{
		eyebrow: 'Client work',
		stat: 'B&O Play',
		statLabel: 'grew to roughly 40% of the business',
		org: 'Bang & Olufsen',
		project: 'Brand growth',
		body: "Helped drive the rise of B&O Play, the lifestyle audio line that grew to represent roughly 40% of Bang & Olufsen's business and, at one stage, effectively all of its growth.",
	},
	{
		eyebrow: 'Client work',
		stat: '$5.15B',
		statLabel: 'Capital One acquisition, April 2026',
		org: 'Brex',
		project: 'Product repositioning',
		body: 'Helped reposition Brex from a backend financial technology platform to a customer-facing expense management platform — the platform Capital One acquired for $5.15B in 2026.',
	},
	{
		eyebrow: 'Client work',
		stat: '8M',
		statLabel: 'units sold in 60 days',
		org: 'Microsoft',
		project: 'Xbox Kinect launch',
		body: 'Confirmed by Guinness World Records as the fastest-selling consumer electronics device of its time — 133,333 units a day.',
	},
	{
		eyebrow: 'Client work',
		stat: 'A cosy revolution',
		statLabel: null,
		org: 'Hay Day (Supercell)',
		project: 'Brand direction',
		body: 'Repositioned Hay Day around a new brand direction to attract new players and set where the brand was headed next — a cosy revolution in place of launch-week metrics.',
	},
	{
		eyebrow: 'At B-Reel',
		stat: 'A first',
		statLabel: 'for luxury retail',
		org: 'Hublot',
		project: 'Digital Boutique',
		body: 'The first human-machine retail experience of its kind for a luxury brand — called a potential game changer by Robb Report.',
	},
];

const categories = [
	{
		label: 'Gaming & entertainment',
		brands: ['Activision Blizzard', 'EA Games', 'Netflix', 'Spotify', 'Vimeo'],
	},
	{
		label: 'Technology',
		brands: ['Apple', 'Google', 'Autodesk', 'Osmo', 'Afterpay'],
	},
	{
		label: 'Fashion, luxury & beauty',
		brands: ['LVMH', 'Richemont', 'PUIG', 'Beats by Dre', 'H&M'],
	},
	{
		label: 'Food, drink & consumer goods',
		brands: ['Barilla', 'Anheuser-Busch InBev', 'Red Bull', 'Burger King', 'Unilever'],
	},
	{
		label: 'Auto & industrial',
		brands: ['Volvo Cars', 'Group 1 Automotive', 'SKF'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Experience — James Jenkins" description="Selected client and agency work across two decades — Nike, Forsman & Bodenfors, Bang & Olufsen, Brex, Xbox, Hay Day, Hublot, and more." image={portrait} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Experience</h1>
			<p class="intro-line">Selected results from client and agency relationships across two decades. None of it was mine alone — every outcome below came from a collective of people I was lucky to work alongside.</p>

			<div class="grid">
				{cases.map((c) => (
					<article class={`case-card ${c.featured ? 'featured' : ''}`}>
						<p class="eyebrow">{c.eyebrow}</p>
						<p class="stat">{c.stat}</p>
						{c.statLabel && <p class="stat-label">{c.statLabel}</p>}
						<p class="case-org">{c.org} <span class="case-project">— {c.project}</span></p>
						<p class="case-body">{c.body}</p>
					</article>
				))}
			</div>

			<section class="also-worked-with">
				<p class="eyebrow">Also worked with</p>
				{categories.map((cat) => (
					<p class="category-row"><span class="category-label">{cat.label}:</span> {cat.brands.join(' · ')}</p>
				))}
			</section>

			<a href="/contact" class="cta">Get in touch</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.3em;
	}
	.intro-line {
		font-size: 1.1em;
		margin-bottom: 2.5em;
		color: rgb(var(--gray-dark));
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5em;
		margin-bottom: 3em;
	}
	.case-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 1.75em;
	}
	.case-card.featured {
		grid-column: 1 / -1;
		padding: 2em;
	}
	.stat {
		font-size: 1.8em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1.15;
		margin: 0 0 0.2em 0;
		letter-spacing: -0.01em;
	}
	.case-card.featured .stat {
		font-size: 2.4em;
	}
	.stat-label {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin-bottom: 1.2em;
	}
	.case-org {
		font-weight: 700;
		color: rgb(var(--black));
		margin-bottom: 0.6em;
		margin-top: 1em;
	}
	.stat-label + .case-org {
		margin-top: 0;
	}
	.case-project {
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.case-body {
		font-size: 0.95em;
		margin-bottom: 0;
	}
	.also-worked-with {
		margin-bottom: 2.5em;
	}
	.category-row {
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		margin-bottom: 0.6em;
	}
	.category-label {
		color: rgb(var(--black));
		font-weight: 600;
	}
	.cta {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: rgb(var(--bg));
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.9em;
	}
	.cta:hover {
		background: var(--accent-dark);
		color: rgb(var(--bg));
	}
</style>
