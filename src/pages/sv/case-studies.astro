---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import portrait from '../../assets/james-about.jpg';

const cases = [
	{
		org: 'Activision Blizzard',
		project: 'Lanseringen av Diablo IV',
		stat: '$666M',
		statLabel: 'i försäljning, första fem dagarna',
		body: 'Blizzards snabbast säljande spel någonsin: 1 miljard dollar i nettobokningar under ett enda kvartal för första gången, och 700+ miljoner speltimmar bland 10+ miljoner spelare på en månad.',
		caveat: 'Ett lagresultat över flera byråer — inte mitt ensamt.',
	},
	{
		org: 'Microsoft',
		project: 'Lanseringen av Xbox Kinect',
		stat: '8M',
		statLabel: 'sålda enheter på 60 dagar',
		body: 'Bekräftat av Guinness World Records som den snabbast säljande konsumentelektroniken i sin tid — 133 333 enheter om dagen.',
		caveat: 'Ett lagresultat över flera byråer — inte mitt ensamt.',
	},
	{
		org: 'Microsoft',
		project: 'Lanseringen av Halo 4',
		stat: '$220M',
		statLabel: 'under de första 24 timmarna',
		body: 'Den största Halo-lanseringen i seriens historia: 4+ miljoner spelare på fem dagar, och en tillhörande serie som passerade 46 miljoner visningar.',
		caveat: 'Ett lagresultat över flera byråer — inte mitt ensamt.',
	},
	{
		org: 'Supercell',
		project: 'Hay Day',
		stat: '$1.4B',
		statLabel: 'i intäkter från appen, totalt',
		body: 'Ett topp-tio-rankat spel inom fyra månader efter global lansering, som i januari 2025 fortfarande drog in ungefär 5 miljoner dollar under en enskild månad.',
		caveat: 'Ett lagresultat. Siffror från januari 2025 (Statista, Sensor Tower).',
	},
	{
		org: 'Nike (på AKQA)',
		project: 'Partnerskap över flera regioner',
		stat: '8 år',
		statLabel: 'över fem regioner',
		body: 'Ett partnerskap som sträckte sig över Nike UK, EMEA, LATAM, APAC och USA, inklusive OS i Beijing, lanseringen av Nike+ och flera VM-kampanjer.',
		caveat: 'Aktivering och genomförande över marknader. Strategi och globalt varumärkesansvar låg hos Wieden+Kennedy.',
	},
	{
		org: 'Hublot (på B-Reel)',
		project: 'Digital Boutique',
		stat: 'En första',
		statLabel: 'inom lyxhandel',
		body: 'Den första människa-maskin-butiksupplevelsen i sitt slag för ett lyxvarumärke — kallad en potentiell spelväxlare av Robb Report.',
		caveat: 'Enbart kvalitativt erkännande; inga försäljningssiffror publicerade. Ett lagresultat på B-Reel.',
	},
];

const alsoWorkedWith = ['Google', 'Volvo Cars', 'Barilla', 'SKF', 'Anheuser-Busch InBev', 'Osmo'];
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title="Fallstudier — James Jenkins" description="Utvalda kund- och byråuppdrag under två decennier — Nike, Xbox, Activision Blizzard, Supercell, Forsman & Bodenfors och fler." image={portrait} />
	</head>
	<body>
		<Header lang="sv" />
		<main>
			<h1>Fallstudier</h1>
			<p class="intro-line">Utvalda resultat från kund- och byråarbete under två decennier. Inget av det var mitt ensamt — varje resultat nedan kom från ett kollektiv av människor jag hade turen att arbeta tillsammans med.</p>

			<section class="featured">
				<p class="eyebrow">Som CEO, 2023–2025</p>
				<h2>Forsman &amp; Bodenfors — tillbaka till tillväxt</h2>
				<p>Som Group CEO, sedan European CEO, för Forsman &amp; Bodenfors i Sverige, Storbritannien och Irland hjälpte jag till att föra byrån tillbaka till tillväxt och god lönsamhet, och fattade de tuffare strukturella besluten som krävdes för att sätta den redo för nästa kapitel.</p>
				<p class="caveat">Ägarens egna uppgifter. Inga oberoende finansiella siffror har publicerats.</p>
			</section>

			<div class="grid">
				{cases.map((c) => (
					<article class="case-card">
						<p class="stat">{c.stat}</p>
						<p class="stat-label">{c.statLabel}</p>
						<p class="case-org">{c.org} <span class="case-project">— {c.project}</span></p>
						<p class="case-body">{c.body}</p>
						<p class="caveat">{c.caveat}</p>
					</article>
				))}
			</div>

			<section class="also-worked-with">
				<p class="eyebrow">Har även arbetat med</p>
				<p class="chip-list">
					{alsoWorkedWith.map((name, i) => <span>{name}{i < alsoWorkedWith.length - 1 ? ' · ' : ''}</span>)}
				</p>
			</section>

			<a href="/sv/contact" class="cta">Kontakta mig</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.3em;
	}
	.intro-line {
		font-size: 1.1em;
		margin-bottom: 2.5em;
		color: rgb(var(--gray-dark));
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}
	.featured {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 2em;
		margin-bottom: 2.5em;
	}
	.featured h2 {
		font-size: 1.6em;
		margin-bottom: 0.5em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5em;
		margin-bottom: 3em;
	}
	.case-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 1.75em;
	}
	.stat {
		font-size: 2.4em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
		margin: 0 0 0.2em 0;
		letter-spacing: -0.01em;
	}
	.stat-label {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin-bottom: 1.2em;
	}
	.case-org {
		font-weight: 700;
		color: rgb(var(--black));
		margin-bottom: 0.6em;
	}
	.case-project {
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.case-body {
		font-size: 0.95em;
		margin-bottom: 1em;
	}
	.caveat {
		font-size: 0.8em;
		font-style: italic;
		color: rgb(var(--gray));
		margin-bottom: 0;
	}
	.also-worked-with {
		margin-bottom: 2.5em;
	}
	.chip-list {
		color: rgb(var(--gray-dark));
	}
	.cta {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: rgb(var(--bg));
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.9em;
	}
	.cta:hover {
		background: var(--accent-dark);
		color: rgb(var(--bg));
	}
</style>
