---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/james-about.jpg';
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title="James Jenkins — Varumärkes- och affärsledare | Medgrundare, Encoded Brands" description="Medgrundare av Encoded Brands, hjälper varumärken att navigera den agentiska eran." image={portrait} />
	</head>
	<body>
		<Header lang="sv" />
		<main>
			<div class="hero-image">
				<Image src={portrait} alt="James Jenkins" widths={[960, 1920]} sizes="960px" />
			</div>
			<div class="prose">
				<h1>Hej</h1>
				<p>
					Jag heter James Jenkins, en varumärkes- och affärsledare med 20+ års erfarenhet av att driva verksamheter där teknologi, kreativitet och kommersiell tillväxt möts. Jag bygger nu Encoded Brands, och hjälper varumärken att navigera den agentiska eran.
				</p>
				<p class="routes">
					<a href="/sv/about">Hela historien</a> · <a href="/sv/advisory">Rådgivning</a> · <a href="https://encodedbrands.ai" target="_blank">Encoded Brands</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	.hero-image {
		width: 100%;
		margin-bottom: 2em;
	}
	.hero-image img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		filter: grayscale(100%);
	}
	.prose {
		max-width: 680px;
	}
	.prose h1 {
		margin-bottom: 0.4em;
	}
	.routes {
		margin-top: 1.5em;
		font-size: 0.95em;
	}
	.routes a {
		color: rgb(var(--gray-dark));
	}
	.routes a:hover {
		color: var(--accent);
	}
</style>
