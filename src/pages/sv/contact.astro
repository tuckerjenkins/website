---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import portrait from '../../assets/james-about.jpg';
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title="Kontakt — James Jenkins" description="Kontakta James Jenkins." image={portrait} />
	</head>
	<body>
		<Header lang="sv" />
		<main>
			<h1>Kontakta mig</h1>
			<p>Om du står inför ett avgörande ögonblick, en ny marknad, en ompositionering eller en verksamhet som behöver peka i en riktning, låt oss prata.</p>
			<div class="actions">
				<a href="mailto:james@encodedbrands.ai" class="cta">Skicka ett mejl</a>
			</div>

			<div class="references">
				<p class="references-label">Referenser tillgängliga på begäran</p>
				<ul class="reference-list">
					<li><span class="ref-name">Ajaz Ahmed</span> — Grundare, AKQA och Studio.One</li>
					<li><span class="ref-name">John Bergdahl</span> — CCO, Forsman &amp; Bodenfors</li>
					<li><span class="ref-name">Melissa Jackson Parsey</span> — Global Chief Strategy Officer, R/GA</li>
					<li><span class="ref-name">David Sable</span> — Vice Chair, Stagwell</li>
					<li><span class="ref-name">Helen James</span> — CEO, The Gate, MSQ Partners</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.4em;
	}
	p {
		max-width: 560px;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 1.5em;
		margin-top: 1.5em;
		flex-wrap: wrap;
	}
	.cta {
		display: inline-block;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: rgb(var(--bg));
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.9em;
	}
	.cta:hover {
		background: var(--accent-dark);
		color: rgb(var(--bg));
	}
	.references {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
		max-width: 560px;
	}
	.references-label {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-bottom: 1em;
	}
	.reference-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.reference-list li {
		color: rgb(var(--gray-dark));
		font-size: 0.9em;
		margin-bottom: 0.6em;
	}
	.ref-name {
		font-weight: 700;
		color: rgb(var(--black));
	}
</style>
