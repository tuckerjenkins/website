---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/james-about.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="James Jenkins — Brand & Business Leader | Co-founder, Encoded Brands" description="Co-founder of Encoded Brands, helping brands navigate the agentic era." image={portrait} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-image">
				<Image src={portrait} alt="James Jenkins" widths={[960, 1920]} sizes="960px" />
			</div>
			<div class="prose">
				<h1>Hello</h1>
				<p>
					I'm James Jenkins, a brand and business leader with 20+ years running organisations where technology, creativity, and commercial growth meet. I'm now building Encoded Brands, helping brands navigate the agentic era.
				</p>
				<p class="routes">
					<a href="/about">The full story</a> · <a href="/advisory">Advisory</a> · <a href="https://encodedbrands.ai" target="_blank">Encoded Brands</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	.hero-image {
		width: 100%;
		margin-bottom: 2em;
	}
	.hero-image img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		filter: grayscale(100%);
	}
	.prose {
		max-width: 680px;
	}
	.prose h1 {
		margin-bottom: 0.4em;
	}
	.routes {
		margin-top: 1.5em;
		font-size: 0.95em;
	}
	.routes a {
		color: rgb(var(--gray-dark));
	}
	.routes a:hover {
		color: var(--accent);
	}
</style>
