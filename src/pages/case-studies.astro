---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import portrait from '../assets/james-about.jpg';

const cases = [
	{
		org: 'Activision Blizzard',
		project: 'Diablo IV launch',
		stat: '$666M',
		statLabel: 'sell-through, first five days',
		body: "Blizzard's fastest-selling game ever: $1B in net bookings in a single quarter for the first time, and 700M+ hours played by 10M+ players in one month.",
		caveat: 'Team outcome across multiple agencies — not mine alone.',
	},
	{
		org: 'Microsoft',
		project: 'Xbox Kinect launch',
		stat: '8M',
		statLabel: 'units sold in 60 days',
		body: 'Confirmed by Guinness World Records as the fastest-selling consumer electronics device of its time — 133,333 units a day.',
		caveat: 'Team outcome across multiple agencies — not mine alone.',
	},
	{
		org: 'Microsoft',
		project: 'Halo 4 launch',
		stat: '$220M',
		statLabel: 'in the first 24 hours',
		body: "The biggest Halo launch in the franchise's history: 4M+ players in five days, and a companion series that passed 46M views.",
		caveat: 'Team outcome across multiple agencies — not mine alone.',
	},
	{
		org: 'Supercell',
		project: 'Hay Day',
		stat: '$1.4B',
		statLabel: 'lifetime in-app revenue',
		body: 'A top-ten grossing game within four months of global launch, still earning roughly $5M in a single month as of January 2025.',
		caveat: 'Team outcome. Figures as of January 2025 (Statista, Sensor Tower).',
	},
	{
		org: 'Nike (at AKQA)',
		project: 'Multi-region partnership',
		stat: '8 years',
		statLabel: 'across five regions',
		body: 'A partnership spanning Nike UK, EMEA, LATAM, APAC and the US, including the Beijing Olympics, the Nike+ launch, and multiple World Cup campaigns.',
		caveat: 'Activation and execution across markets. Strategy and global brand lead sat with Wieden+Kennedy.',
	},
	{
		org: 'Hublot (at B-Reel)',
		project: 'Digital Boutique',
		stat: 'A first',
		statLabel: 'for luxury retail',
		body: 'The first human-machine retail experience of its kind for a luxury brand — called a potential game changer by Robb Report.',
		caveat: 'Qualitative recognition only; no sales figures published. Team outcome at B-Reel.',
	},
];

const alsoWorkedWith = ['Google', 'Volvo Cars', 'Barilla', 'SKF', 'Anheuser-Busch InBev', 'Osmo'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Case studies — James Jenkins" description="Selected client and agency work across two decades — Nike, Xbox, Activision Blizzard, Supercell, Forsman & Bodenfors, and more." image={portrait} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Case studies</h1>
			<p class="intro-line">Selected results from client and agency relationships across two decades. None of it was mine alone — every outcome below came from a collective of people I was lucky to work alongside.</p>

			<section class="featured">
				<p class="eyebrow">As CEO, 2023–2025</p>
				<h2>Forsman &amp; Bodenfors — back to growth</h2>
				<p>As Group CEO, then European CEO, of Forsman &amp; Bodenfors across Sweden, the UK, and Ireland, I helped return the agency to growth and meaningful profitability, and made the harder structural calls needed to set it up for its next chapter.</p>
				<p class="caveat">Owner-stated. No independent financial figures published.</p>
			</section>

			<div class="grid">
				{cases.map((c) => (
					<article class="case-card">
						<p class="stat">{c.stat}</p>
						<p class="stat-label">{c.statLabel}</p>
						<p class="case-org">{c.org} <span class="case-project">— {c.project}</span></p>
						<p class="case-body">{c.body}</p>
						<p class="caveat">{c.caveat}</p>
					</article>
				))}
			</div>

			<section class="also-worked-with">
				<p class="eyebrow">Also worked with</p>
				<p class="chip-list">
					{alsoWorkedWith.map((name, i) => <span>{name}{i < alsoWorkedWith.length - 1 ? ' · ' : ''}</span>)}
				</p>
			</section>

			<a href="/contact" class="cta">Get in touch</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.3em;
	}
	.intro-line {
		font-size: 1.1em;
		margin-bottom: 2.5em;
		color: rgb(var(--gray-dark));
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75em;
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}
	.featured {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 2em;
		margin-bottom: 2.5em;
	}
	.featured h2 {
		font-size: 1.6em;
		margin-bottom: 0.5em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5em;
		margin-bottom: 3em;
	}
	.case-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 1.75em;
	}
	.stat {
		font-size: 2.4em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
		margin: 0 0 0.2em 0;
		letter-spacing: -0.01em;
	}
	.stat-label {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin-bottom: 1.2em;
	}
	.case-org {
		font-weight: 700;
		color: rgb(var(--black));
		margin-bottom: 0.6em;
	}
	.case-project {
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.case-body {
		font-size: 0.95em;
		margin-bottom: 1em;
	}
	.caveat {
		font-size: 0.8em;
		font-style: italic;
		color: rgb(var(--gray));
		margin-bottom: 0;
	}
	.also-worked-with {
		margin-bottom: 2.5em;
	}
	.chip-list {
		color: rgb(var(--gray-dark));
	}
	.cta {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: rgb(var(--bg));
		text-decoration: none;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.9em;
	}
	.cta:hover {
		background: var(--accent-dark);
		color: rgb(var(--bg));
	}
</style>
