---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

// hreflang alternates — only the routes that exist in both English and Swedish.
// Every built page other than the root uses a trailing slash (matches the sitemap).
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isSv = normalizedPath === '/sv' || normalizedPath.startsWith('/sv/');
const enPath = isSv ? normalizedPath.replace(/^\/sv/, '') || '/' : normalizedPath;
const svPath = isSv ? normalizedPath : enPath === '/' ? '/sv' : `/sv${enPath}`;
const bilingualPaths = new Set(['/', '/about', '/advisory', '/contact']);
const withTrailingSlash = (path: string) => (path === '/' ? '/' : `${path}/`);
const hasTranslation = bilingualPaths.has(enPath);
const enHreflangURL = hasTranslation ? new URL(withTrailingSlash(enPath), Astro.site) : null;
const svHreflangURL = hasTranslation ? new URL(withTrailingSlash(svPath), Astro.site) : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Language alternates -->
{hasTranslation && (
	<>
		<link rel="alternate" hreflang="en" href={enHreflangURL} />
		<link rel="alternate" hreflang="sv" href={svHreflangURL} />
		<link rel="alternate" hreflang="x-default" href={enHreflangURL} />
	</>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- Structured data: this site also publishes a machine-readable Brand Context Protocol file at /.well-known/brand.md -->
<link rel="alternate" type="text/markdown" title="Brand Context Protocol" href="/.well-known/brand.md" />
<script type="application/ld+json" set:html={JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': 'https://www.jamesjenkins.work/#person',
			name: 'James Jenkins',
			url: 'https://www.jamesjenkins.work',
			jobTitle: 'Co-founder, Encoded Brands',
			description: 'Brand and business leader with 20+ years running organisations where technology, creativity, and commercial growth meet.',
			worksFor: { '@id': 'https://encodedbrands.ai/#organization' },
			alumniOf: {
				'@type': 'CollegeOrUniversity',
				name: 'Newcastle University',
			},
			affiliation: [
				{ '@type': 'Organization', name: 'Forsman & Bodenfors', url: 'https://www.forsman.com' },
				{ '@type': 'Organization', name: 'B-Reel', url: 'https://b-reel.com' },
				{ '@type': 'Organization', name: 'AKQA', url: 'https://www.akqa.com' },
			],
			sameAs: ['https://www.linkedin.com/in/jamesgjenkins/', 'https://substack.com/@jamesj322928'],
		},
		{
			'@type': 'Organization',
			'@id': 'https://encodedbrands.ai/#organization',
			name: 'Encoded Brands',
			url: 'https://encodedbrands.ai',
			founder: { '@id': 'https://www.jamesjenkins.work/#person' },
		},
	],
})} />
